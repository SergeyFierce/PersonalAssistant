<?xml version="1.0" encoding="utf-8"?>
<!--
  Правила авто-бэкапа (Auto Backup). На API 31+ при наличии data_extraction_rules.xml
  приоритет отдаётся ему; здесь задаётся поведение для старых устройств.
  Документация: https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Включаем DataStore с настройками (включённые сервисы, тема, уведомления и т.д.)
         для восстановления при переносе на новое устройство или переустановке приложения. -->
    <include domain="file" path="datastore"/>
</full-backup-content>
