<?xml version="1.0" encoding="utf-8"?>
<!--
  Правила извлечения данных для бэкапа (API 12+): облачный бэкап и перенос между устройствами.
  Политика: бэкапим только DataStore с настройками пользователя для восстановления при
  смене устройства или переустановке. Документация:
  https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore"/>
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore"/>
    </device-transfer>
</data-extraction-rules>
